#!/usr/bin/env python3
"""Run RigMark commands without installing a package."""

from __future__ import annotations

import os
import sys
from pathlib import Path


COMMANDS = {
    "audit-code": "audit_code.py",
    "configure": "configure.py",
    "run": "bench.py",
    "report": "report.py",
    "compare": "compare.py",
}


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        choices = " | ".join(COMMANDS)
        print(f"usage: ./rigmark {{{choices}}} [options]", file=sys.stderr)
        raise SystemExit(2)
    script = Path(__file__).resolve().with_name(COMMANDS[sys.argv[1]])
    os.execv(sys.executable, [sys.executable, str(script), *sys.argv[2:]])


if __name__ == "__main__":
    main()
